-.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 48px; padding: 0 24px; border: 1px solid transparent; border-radius: var(--r-md); font-size: 14.5px; font-weight: 700; letter-spacing: -0.01em; transition: background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.25s var(--ease), transform 0.25s var(--ease), color 0.2s ease; cursor: pointer; text-decoration: none; }
