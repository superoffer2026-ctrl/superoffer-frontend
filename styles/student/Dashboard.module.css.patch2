--- superoffer-frontend/styles/student/Dashboard.module.css
+++ superoffer-frontend/styles/student/Dashboard.module.css
@@ -107,67 +107,96 @@
 
 /* ------------------------------------------------------ opportunities grid -- */
 
-.blockHead { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 24px; }
-.blockHead h2 { font-size: clamp(24px, 3vw, 28px); font-weight: 800; letter-spacing: -0.03em; margin: 8px 0 0; color: #0f172a; }
-.eyebrowPlain { font-size: 11px; font-weight: 700; color: var(--em); letter-spacing: 0.1em; text-transform: uppercase; }
-.viewAll { color: var(--em); font-size: 14px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
-.viewAll:hover { text-decoration: underline; }
+.statsGrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 32px; }
+.statCard { display: flex; align-items: center; gap: 16px; background: white; padding: 24px; border-radius: 20px; border: 1px solid var(--line); box-shadow: var(--sh-1); }
+.statCardIcon { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 14px; background: var(--soft); color: var(--ink-2); }
+.statCard.em .statCardIcon { background: var(--em-soft); color: var(--em); }
+.statCard h3 { font-size: 24px; font-weight: 800; color: #0f172a; margin: 0; line-height: 1.2; }
+.statCard p { font-size: 13.5px; font-weight: 500; color: #64748b; margin: 0; }
 
-.grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
-.oppCard {
-  background: var(--paper);
-  border-radius: 20px;
-  overflow: hidden;
-  border: 1px solid var(--line);
-  box-shadow: var(--sh-1);
-  transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease);
-  text-decoration: none;
-  display: flex;
-  flex-direction: column;
+.dashboardGrid { display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 40px; }
+.mainColumn { display: flex; flex-direction: column; gap: 24px; }
+.sideColumn { display: flex; flex-direction: column; gap: 24px; }
+
+.dashPanel { background: white; border-radius: 24px; border: 1px solid var(--line); box-shadow: var(--sh-1); overflow: hidden; }
+.panelHead { padding: 24px 28px 16px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
+.panelHead h3 { font-size: 17px; font-weight: 700; color: #0f172a; margin: 0; }
+.panelHead a { font-size: 13.5px; font-weight: 600; color: var(--em); text-decoration: none; }
+.panelHead a:hover { text-decoration: underline; }
+
+.panelBody { padding: 20px 28px; }
+
+.emptyState { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; text-align: center; }
+.emptyStateIcon { width: 64px; height: 64px; border-radius: 50%; background: var(--soft); color: var(--ink-3); display: grid; place-items: center; margin-bottom: 16px; }
+.emptyState h4 { font-size: 16px; font-weight: 700; color: #1e293b; margin: 0 0 8px; }
+.emptyState p { font-size: 14px; color: #64748b; margin: 0 0 20px; max-width: 32ch; }
+
+.offerList { display: flex; flex-direction: column; }
+.offerRow { display: flex; align-items: center; justify-content: space-between; padding: 16px 0; border-bottom: 1px solid var(--line); }
+.offerRow:last-child { border-bottom: none; padding-bottom: 0; }
+.offerLeft { display: flex; align-items: center; gap: 16px; }
+.offerLogo { width: 48px; height: 48px; border-radius: 12px; border: 1px solid var(--line); background: #fff; padding: 4px; object-fit: contain; }
+.offerInfo h4 { font-size: 15px; font-weight: 600; color: #0f172a; margin: 0 0 4px; }
+.offerInfo p { font-size: 13px; color: #64748b; margin: 0; }
+.offerRight { display: flex; align-items: center; gap: 12px; }
+.offerStatus { display: inline-flex; align-items: center; padding: 4px 10px; border-radius: var(--r-full); font-size: 12px; font-weight: 600; }
+.offerStatus.new { background: var(--em-soft); color: var(--em); }
+.offerStatus.viewed { background: var(--soft); color: var(--ink-2); }
+
+.promoBanner { display: flex; align-items: center; justify-content: space-between; background: var(--em-soft); border-radius: 20px; padding: 24px 32px; border: 1px solid rgba(13, 148, 136, 0.2); }
+.promoLeft { display: flex; align-items: center; gap: 20px; }
+.promoIcon { width: 56px; height: 56px; background: white; border-radius: 50%; display: grid; place-items: center; color: var(--em); box-shadow: var(--sh-1); }
+.promoText h4 { font-size: 18px; font-weight: 700; color: var(--em-deep); margin: 0 0 4px; }
+.promoText p { font-size: 14px; color: #334155; margin: 0; }
+
+/* Profile Checklist (moved from hero) */
+.checklist { display: flex; flex-direction: column; gap: 16px; }
+.checklistItem { display: flex; align-items: center; justify-content: space-between; font-size: 14px; font-weight: 600; color: #334155; }
+.checklistItemLeft { display: flex; align-items: center; gap: 12px; }
+.checklistItemLeft svg { color: #94a3b8; }
+.checklistItemRight { display: flex; align-items: center; }
+.checklistItemRight .done { color: var(--em); }
+.checklistItemRight .pending { color: #cbd5e1; }
+.cardBtn { width: 100%; margin-top: 24px; height: 44px; }
+
+.progressHeader { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
+.circularProgress { width: 44px; height: 44px; position: relative; }
+.circularProgress svg { width: 100%; height: 100%; transform: rotate(-90deg); }
+.circularProgress circle.bg { fill: none; stroke: var(--soft-2); stroke-width: 4.5; }
+.circularProgress circle.fg { fill: none; stroke: var(--em); stroke-width: 4.5; stroke-linecap: round; transition: stroke-dashoffset 1s ease; }
+.progressTitle { display: flex; flex-direction: column; gap: 3px; }
+.progressTitle b { font-size: 15.5px; font-weight: 700; color: #0f172a; line-height: 1; }
+.progressTitle span { font-size: 13px; color: #64748b; font-weight: 500; }
+
+/* Recent Activity */
+.activityList { display: flex; flex-direction: column; gap: 20px; }
+.activityItem { display: flex; gap: 16px; }
+.activityIcon { width: 36px; height: 36px; border-radius: 50%; background: #f1f5f9; display: grid; place-items: center; color: #475569; flex-shrink: 0; }
+.activityBody { flex-grow: 1; display: flex; justify-content: space-between; align-items: flex-start; }
+.activityText { display: flex; flex-direction: column; gap: 2px; }
+.activityText b { font-size: 14px; font-weight: 600; color: #1e293b; }
+.activityText span { font-size: 12px; color: #64748b; }
+.activityTime { font-size: 11px; color: #94a3b8; font-weight: 500; }
+
+/* Cleanup Old Classes */
+.blockHead, .grid4, .oppCard, .oppImg, .oppIcon, .oppBody, .oppTitleRow, .oppArrow, .oppBadge, .lowerGrid, .loanBanner, .loanBannerBg, .loanBannerContent, .loanBannerEyebrow, .loanBannerTitle, .loanBannerDesc { display: none; }
+
+/* ============================================================ responsive = */
+@media (max-width: 1100px) {
+  .hero { flex-direction: column; align-items: stretch; }
+  .heroBgContainer { display: none; }
+  .dashboardGrid { grid-template-columns: 1fr; }
+  .promoBanner { flex-direction: column; align-items: flex-start; gap: 20px; }
 }
-.oppCard:hover {
-  transform: translateY(-4px);
-  box-shadow: var(--sh-2);
-}
-.oppImg { height: 120px; width: 100%; position: relative; }
-.oppImg img { width: 100%; height: 100%; object-fit: cover; }
-.oppImg::after { content: ''; position: absolute; bottom: -20px; left: -10%; right: -10%; height: 40px; background: var(--paper); transform: rotate(-3deg); border-top-left-radius: 50%; border-top-right-radius: 50%; }
-.oppIcon { position: absolute; bottom: 8px; left: 16px; width: 36px; height: 36px; background: white; border-radius: 50%; display: grid; place-items: center; box-shadow: var(--sh-1); color: var(--em); z-index: 2; }
-.oppBody { padding: 20px 16px; display: flex; flex-direction: column; flex-grow: 1; position: relative; z-index: 1; }
-.oppTitleRow { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 4px; }
-.oppTitleRow h3 { margin: 0; font-size: 15px; font-weight: 700; color: #0f172a; }
-.oppBody p { margin: 0; font-size: 13px; color: #64748b; line-height: 1.4; }
-.oppArrow { color: #94a3b8; }
-.oppCard:hover .oppArrow { color: var(--em); transform: translateX(2px); transition: transform 0.2s; }
-.oppBadge { position: absolute; bottom: 20px; right: 16px; background: var(--em-soft); color: var(--em); font-size: 11px; font-weight: 700; padding: 4px 8px; border-radius: 12px; display: flex; align-items: center; gap: 4px; }
-
-/* ------------------------------------------------------ lower section -- */
-
-.lowerGrid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 24px; margin-top: 40px; }
-
-.loanBanner {
-  position: relative;
-  border-radius: 24px;
-  overflow: hidden;
