-.loanBannerBg { position: absolute; top: 0; right: 0; bottom: 0; width: 60%; z-index: 0; }
-.loanBannerBg img { width: 100%; height: 100%; object-fit: cover; mask-image: linear-gradient(to right, transparent, black 40%); -webkit-mask-image: linear-gradient(to right, transparent, black 40%); mix-blend-mode: multiply; opacity: 0.9; }
-.loanBannerContent { position: relative; z-index: 1; max-width: 65%; }
-.loanBannerEyebrow { display: inline-flex; align-items: center; gap: 6px; color: var(--em); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 12px; }
-.loanBannerTitle { font-size: 28px; font-weight: 800; color: #0f172a; margin: 0 0 8px; letter-spacing: -0.02em; }
-.loanBannerTitle span { color: var(--em); }
-.loanBannerDesc { font-size: 14px; color: #334155; margin: 0 0 24px; line-height: 1.5; }
-
