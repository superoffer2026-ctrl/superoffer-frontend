 .content [data-i] { animation: enter 0.7s var(--ease) both; animation-delay: calc(var(--i, 0) * 90ms); }
 @keyframes enter { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
 
+/* ---------------------------------------------------------------- dashboard backdrop -- */
+.dashboardHeroBg {
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  height: 520px;
+  background-image: url('/dashboard/hero-bg.jpg');
+  background-size: cover;
+  background-position: center;
+  z-index: -1;
+}
