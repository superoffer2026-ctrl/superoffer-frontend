 .eyebrow { display: inline-flex; align-items: center; gap: 8px; color: var(--em); font-size: 11px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; }
 .eyebrow i { width: 7px; height: 7px; border-radius: 50%; background: var(--em); }
-.hero h1 { margin: 18px 0 0; font-size: clamp(30px, 4vw, 50px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.04; max-width: 14ch; }
-.heroLede { max-width: 46ch; margin: 16px 0 0; color: var(--ink-2); font-size: clamp(14.5px, 1.1vw, 16px); line-height: 1.6; }
+.hero h1 { margin: 18px 0 0; font-size: clamp(40px, 5vw, 64px); font-weight: 800; letter-spacing: -0.04em; line-height: 1.05; max-width: 16ch; color: #0f172a; }
+.hero h1 span { color: var(--em); }
