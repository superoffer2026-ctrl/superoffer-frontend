# Copy to .env and fill in real values before running `docker compose up`.
# .env is gitignored — never commit real secrets.

# Postgres (used by the db container and assembled into backend's DATABASE_URL)
POSTGRES_USER=superoffer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=superoffer

# Backend
# Generate with: openssl rand -hex 32
AUTH_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
# Origin the browser will call the frontend from (must match FRONTEND_PORT below)
CORS_ORIGIN=http://localhost:8080

# Frontend
# Must be reachable from the user's BROWSER, not just from inside Docker
# (e.g. https://api.yourdomain.com/api/v1 in production, not http://backend:3000/api/v1)
SUPER_OFFER_API_URL=http://localhost:3000/api/v1

# Host port mappings
BACKEND_PORT=3000
FRONTEND_PORT=8080
